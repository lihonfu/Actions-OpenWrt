#!/bin/sh
# SSR Plus+ DNS 模式修正。
#
# pdnsd_enable 不是 pdnsd 开关，是 DNS 模式选择器：
#   1 -> dns2tcp      上游取自 tunnel_forward（默认 8.8.4.4:53），
#                     需要代理先可用才能解析，启动期自锁，且代码无 fallback
#   4 -> mosdns       本构建未编译
#   6 -> chinadns-ng  本构建未编译
#   7 -> mihomo 内置 DNS，不依赖任何外部二进制或墙外上游
#
# 统一强制 7。前缀 99- 保证排在 luci-ssr-plus 之后执行。

[ -f /etc/config/shadowsocksr ] || exit 0

cur="$(uci -q get shadowsocksr.@global[0].pdnsd_enable)"
if [ "$cur" != "7" ]; then
	uci -q set shadowsocksr.@global[0].pdnsd_enable='7'
	uci -q commit shadowsocksr
fi

exit 0
